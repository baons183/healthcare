# Lấy ở Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Đọc ảnh sổ tiêm bằng AI – lấy tại https://platform.claude.com (Settings > API keys)
# BÍ MẬT: không đặt tiền tố NEXT_PUBLIC_, trên Vercel bật "Sensitive"
ANTHROPIC_API_KEY=sk-ant-...

# Thông báo đẩy (Web Push). Tạo VAPID keys: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Chuỗi ngẫu nhiên – Vercel Cron gửi kèm để gọi /api/cron/daily
CRON_SECRET=
# Supabase > Project Settings > API Keys > secret key – BÍ MẬT, chỉ dùng trên server
SUPABASE_SERVICE_ROLE_KEY=

# Email nhắc lịch (tùy chọn) – VD Gmail: bật xác minh 2 bước, tạo "Mật khẩu ứng dụng" tại myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# MAIL_FROM="Sổ Sức Khỏe <ban@gmail.com>"
# Đường dẫn app dùng trong email (mặc định tự lấy từ Vercel)
# APP_URL=https://healthcare-nine-iota.vercel.app
